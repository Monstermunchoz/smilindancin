# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Commerce : "local" (JSON de démo, sans paiement) ou "shopify" ---
COMMERCE_PROVIDER=local

# --- Shopify (uniquement si COMMERCE_PROVIDER=shopify) — jamais préfixé NEXT_PUBLIC_, jamais commité ---
SHOPIFY_STORE_DOMAIN=smilin-dancin.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# --- Espace admin (/admin) ---
ADMIN_PASSWORD=smilin-admin
ADMIN_SESSION_SECRET=change-me-with-a-long-random-string

# --- Stripe (paiement en ligne) — active automatiquement le checkout Stripe quand STRIPE_SECRET_KEY est défini ---
# Dashboard Stripe → Developers → API keys. Utiliser les clés TEST (sk_test_…) en développement.
STRIPE_SECRET_KEY=
# Dashboard Stripe → Developers → Webhooks → endpoint <site>/api/webhooks/stripe (events: checkout.session.completed, charge.refunded)
# En local : `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# --- Base de données (obligatoire en production) ---
# Supabase : ajouté automatiquement par l'intégration Vercel ↔ Supabase (POSTGRES_URL).
# Sinon : Supabase → Connect → "Transaction pooler" → coller l'URI ici.
POSTGRES_URL=
